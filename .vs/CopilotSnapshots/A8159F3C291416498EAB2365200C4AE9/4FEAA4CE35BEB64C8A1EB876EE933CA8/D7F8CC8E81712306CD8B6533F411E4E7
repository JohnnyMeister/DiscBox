using System;
using System.Runtime.InteropServices;

namespace DiscBox.Services;

/// <summary>
/// P/Invoke declarations — mapeia diretamente as funções do libdiscbox.dll
/// </summary>
internal static class DiscboxNative
{
    const string Lib = "discbox";

    // ── Init / Free ───────────────────────────────────────────
    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern IntPtr discbox_init(
        string webhook_url, string db_path, IntPtr config);

    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern void discbox_free(IntPtr ctx);

    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern IntPtr discbox_last_error(IntPtr ctx);

    // ── Virtual FS ────────────────────────────────────────────
    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern int discbox_mkdir(IntPtr ctx, string virtual_path);

    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern int discbox_list(
        IntPtr ctx, string virtual_path,
        out IntPtr entries, out UIntPtr count);

    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern void discbox_free_entries(IntPtr entries, UIntPtr count);

    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern int discbox_rename(
        IntPtr ctx, string old_path, string new_path);

    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern int discbox_delete(IntPtr ctx, string virtual_path);

    // ── Transfer ──────────────────────────────────────────────
    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern int discbox_upload(
        IntPtr ctx, string local_path, string virtual_path,
        ProgressCallback? progress_cb, IntPtr userdata);

    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern int discbox_download(
        IntPtr ctx, string virtual_path, string local_path,
        ProgressCallback? progress_cb, IntPtr userdata);

    // ── Utilities ─────────────────────────────────────────────
    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern int discbox_validate_webhook(string webhook_url);

    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern long discbox_total_size(IntPtr ctx);

    [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]
    public static extern IntPtr discbox_strerror(int err);

    // ── Structs (must match C layout exactly) ─────────────────
    [StructLayout(LayoutKind.Sequential)]
    public struct NativeEntry
    {
        public long id;
        public IntPtr name;
        public IntPtr virtual_path;
        public int type;           // 0=file, 1=folder
        public long size_bytes;
        public IntPtr mime_type;
        public IntPtr thumbnail_url;
        public long created_at;     // unix timestamp
        public long modified_at;
        public int encrypted;
    }

    // Progress callback signature
    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
    public delegate int ProgressCallback(
        IntPtr userdata,
        IntPtr virtual_path,
        long bytes_done,
        long bytes_total,
        int chunk_index,
        int chunk_count);
}