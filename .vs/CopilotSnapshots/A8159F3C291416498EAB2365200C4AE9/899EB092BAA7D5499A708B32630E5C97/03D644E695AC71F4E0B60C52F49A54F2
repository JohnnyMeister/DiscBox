<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiscBox.ViewModels"
        xmlns:m="using:DiscBox.Models"
        x:Class="DiscBox.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding DriveName, StringFormat='DiscBox — {0}'}"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0f1117">

  <Window.Styles>
    <Style Selector="Button.sidebar-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8e9297"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.sidebar-item:pointerover">
      <Setter Property="Background" Value="#2e3148"/>
      <Setter Property="Foreground" Value="#e3e5e8"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#2e3148"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1a1d27"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="200,*">

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#1a1d27" BorderBrush="#2e3148" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,18,20,14" BorderBrush="#2e3148" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="&#128230;" FontSize="22"/>
            <StackPanel>
              <TextBlock Text="DiscBox" FontSize="15" FontWeight="Bold" Foreground="#e3e5e8"/>
              <TextBlock Text="{Binding DriveName}" FontSize="11" Foreground="#8e9297"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="12,12,12,4">
          <Button Content="Upload File" Command="{Binding UploadFileCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Background="#5865f2" Foreground="White"
                  CornerRadius="6" Height="36" FontSize="13"/>
        </Border>
        <Border DockPanel.Dock="Top" Padding="12,0,12,4">
          <Button Content="⬇ Importar do Disbox"
                  Command="{Binding MigrateFromDisboxCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="#2e3148" Foreground="#e3e5e8"
                  CornerRadius="6" Height="36" FontSize="12"
                  Margin="0,4,0,0"/>
        </Border>
       
        <StackPanel DockPanel.Dock="Top" Margin="12,8" Spacing="2">
          <TextBlock Text="DRIVE" FontSize="10" FontWeight="SemiBold"
                     Foreground="#4f5460" Margin="12,0,0,6" LetterSpacing="2"/>
          <Button Classes="sidebar-item" Command="{Binding NavigateToCommand}" CommandParameter="/" Content="Home  Root"/>
          <Button Classes="sidebar-item" Command="{Binding NavigateToCommand}" CommandParameter="/Photos" Content="Photos"/>
          <Button Classes="sidebar-item" Command="{Binding NavigateToCommand}" CommandParameter="/Videos" Content="Videos"/>
          <Button Classes="sidebar-item" Command="{Binding NavigateToCommand}" CommandParameter="/Documents" Content="Documents"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main content -->
    <DockPanel Grid.Column="1">

      <!-- Toolbar -->
      <Border DockPanel.Dock="Top" Background="#1a1d27"
              BorderBrush="#2e3148" BorderThickness="0,0,0,1" Padding="12,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <Button Content="&lt;" Command="{Binding GoUpCommand}"
                    Background="Transparent" Foreground="#8e9297"
                    CornerRadius="6" Width="32" Height="32"
                    HorizontalContentAlignment="Center" FontSize="14"/>
            <Button Content="R" Command="{Binding RefreshCommand}"
                    Background="Transparent" Foreground="#8e9297"
                    CornerRadius="6" Width="32" Height="32"
                    HorizontalContentAlignment="Center" FontSize="14"/>
          </StackPanel>

          <!-- Breadcrumbs: ItemsSource + x:DataType on DataTemplate -->
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Breadcrumbs}"
                        Margin="8,0" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:BreadcrumbItem">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Content="{Binding Label}"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateToCommand}"
                          CommandParameter="{Binding Path}"
                          Background="Transparent" Foreground="#8e9297"
                          Padding="4,2" CornerRadius="4" FontSize="13"/>
                  <TextBlock Text=" > " Foreground="#4f5460" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Grid.Column="2" Content="New Folder"
                  Command="{Binding NewFolderCommand}"
                  Background="#2e3148" Foreground="#e3e5e8"
                  CornerRadius="6" Padding="12,6" FontSize="12"/>
        </Grid>
      </Border>

      <!-- Status bar -->
      <Border DockPanel.Dock="Bottom" Background="#1a1d27"
              BorderBrush="#2e3148" BorderThickness="0,1,0,0" Padding="16,6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                     Foreground="#8e9297" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding CurrentPath}"
                     Foreground="#4f5460" FontSize="11" VerticalAlignment="Center"
                     FontFamily="Cascadia Code,Consolas,monospace"/>
        </Grid>
      </Border>

      <!-- File list: ItemsSource (Avalonia 11, not Items) -->
      <ListBox ItemsSource="{Binding Entries}"
               SelectedItem="{Binding SelectedEntry}"
               DoubleTapped="OnEntryDoubleTapped"
               Background="Transparent">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="⬇ Download"
                      Command="{Binding DownloadEntryCommand}"
                      CommandParameter="{Binding SelectedEntry}"
                      IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Separator/>
            <MenuItem Header="✂ Cortar"
                      Command="{Binding CutEntryCommand}"
                      CommandParameter="{Binding SelectedEntry}"
                      IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <MenuItem Header="📋 Copiar"
                      Command="{Binding CopyEntryCommand}"
                      CommandParameter="{Binding SelectedEntry}"
                      IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <MenuItem Header="📌 Colar"
                      Command="{Binding PasteCommand}"
                      IsVisible="{Binding HasClipboard}"/>
            <Separator/>
            <MenuItem Header="✏ Renomear"
                      Command="{Binding RenameEntryCommand}"
                      CommandParameter="{Binding SelectedEntry}"
                      IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <MenuItem Header="🗑 Apagar"
                      Command="{Binding DeleteEntryCommand}"
                      CommandParameter="{Binding SelectedEntry}"
                      IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Separator/>
            <MenuItem Header="🔗 Copiar caminho"
                      Command="{Binding CopyPathCommand}"
                      CommandParameter="{Binding SelectedEntry}"
                      IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <MenuItem Header="ℹ Propriedades"
                      Command="{Binding ShowPropertiesCommand}"
                      CommandParameter="{Binding SelectedEntry}"
                      IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Separator/>
            <MenuItem Header="📁 Nova Pasta" Command="{Binding NewFolderCommand}"/>
            <MenuItem Header="⬆ Upload" Command="{Binding UploadFileCommand}"/>
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="m:FileEntry">
            <Grid ColumnDefinitions="36,*,120,160" Height="40">
              <TextBlock Grid.Column="0" Text="{Binding Icon}"
                         FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Name}"
                         Foreground="#e3e5e8" FontSize="13" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                         Foreground="#8e9297" FontSize="12"
                         VerticalAlignment="Center" HorizontalAlignment="Right"
                         Margin="0,0,16,0"/>
              <TextBlock Grid.Column="3"
                         Text="{Binding ModifiedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                         Foreground="#4f5460" FontSize="11"
                         VerticalAlignment="Center" HorizontalAlignment="Right"
                         Margin="0,0,16,0"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </DockPanel>
  </Grid>
</Window>
