<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiscBox.ViewModels"
        xmlns:m="using:DiscBox.Models"
        xmlns:ctrl="using:DiscBox.Controls"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="DiscBox.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding DriveName, StringFormat='DiscBox - {0}'}"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        ExtendClientAreaToDecorationsHint="True">

  <Window.Styles>
    <Style Selector="Button.sidebar-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8E9297"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style Selector="Button.sidebar-item:pointerover">
      <Setter Property="Background" Value="#1A2033"/>
      <Setter Property="Foreground" Value="#00E5FF"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#121826"/>
    </Style>
    <Style Selector="TextBox.search-box">
      <Setter Property="Background" Value="#111622"/>
      <Setter Property="Foreground" Value="#E3E5E8"/>
      <Setter Property="BorderBrush" Value="#2A324A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="34,8,12,8"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBox.search-box:focus">
      <Setter Property="BorderBrush" Value="#00E5FF"/>
    </Style>
    <Style Selector="Button.quick-access-toggle">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.quick-access-toggle:pointerover">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.quick-access-toggle:pressed">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Window.Styles>

  <!-- Content with TitleBar spacing since ExtendClientArea is True -->
  <Grid ColumnDefinitions="240,*">

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#161B29" BorderBrush="#2A324A" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Spacer for TitleBar height -->
        <Border DockPanel.Dock="Top" Height="30" />
        
        <Border DockPanel.Dock="Top" Height="70" Padding="20,0" BorderBrush="#2A324A" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Image Source="avares://DiscBox/Assets/logo.png" Width="42" Height="42"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="DiscBox" FontSize="18" FontWeight="Bold" Foreground="#E3E5E8"/>
              <TextBlock Text="{Binding DriveName}" FontSize="12" Foreground="#00E5FF" FontWeight="SemiBold"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="16,20,16,8">
          <StackPanel Spacing="8">
            <Button Command="{Binding UploadFileCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#00E5FF" Foreground="#0B0F19"
                    CornerRadius="8" Height="40" FontSize="14" FontWeight="Bold">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="CloudUpload" Width="20" Height="20"/>
                <TextBlock Text="Upload File" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding UploadFolderCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#1A2033" Foreground="#E3E5E8"
                    BorderBrush="#2A324A" BorderThickness="1"
                    CornerRadius="8" Height="36" FontSize="13" FontWeight="SemiBold">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="FolderUpload" Width="18" Height="18" Foreground="#00E5FF"/>
                <TextBlock Text="Upload Folder" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="16,0,16,8">
          <Button Command="{Binding MigrateFromDisboxCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Background="#2A324A" Foreground="#E3E5E8"
                  CornerRadius="8" Height="40" FontSize="13" FontWeight="SemiBold"
                  Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <material:MaterialIcon Kind="CloudSync" Width="18" Height="18"/>
              <TextBlock Text="Sync Cloud" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="16,12,16,18"
                BorderBrush="#2A324A"
                BorderThickness="0,1,0,0">
          <Button Command="{Binding OpenBuyMeCoffeeCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="#1A2033"
                  Foreground="#E3E5E8"
                  BorderBrush="#2A324A"
                  BorderThickness="1"
                  CornerRadius="8"
                  Height="42"
                  FontSize="13"
                  FontWeight="SemiBold"
                  ToolTip.Tip="Support DiscBox">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <material:MaterialIcon Kind="Coffee" Width="18" Height="18" Foreground="#FACC15"/>
              <TextBlock Text="Buy me a coffee" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Border>
      
        <StackPanel DockPanel.Dock="Top" Margin="16,12" Spacing="2">
          <Grid ColumnDefinitions="*,Auto" Margin="12,0,0,10">
            <TextBlock Grid.Column="0" Text="DRIVE" FontSize="11" FontWeight="Bold"
                       Foreground="#6A0DAD" LetterSpacing="2" VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Command="{Binding AddDriveCommand}"
                    Background="Transparent"
                    Foreground="#00E5FF"
                    Width="28" Height="28"
                    CornerRadius="6"
                    Padding="0"
                    ToolTip.Tip="Add drive">
              <material:MaterialIcon Kind="Plus" Width="18" Height="18"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding Drives}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <Button Grid.Column="0"
                          Classes="sidebar-item"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SwitchDriveCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*">
                      <material:MaterialIcon Grid.Column="0" Kind="Harddisk" Width="20" Height="20" Foreground="#00E5FF"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14"
                                 Margin="12,0,0,0"
                                 TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </Button>
                  <Button Grid.Column="1"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleDriveEncryptionCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          Foreground="#8E9297"
                          Width="28" Height="38"
                          Padding="0"
                          CornerRadius="6"
                          ToolTip.Tip="Toggle encryption">
                    <Panel Width="16" Height="16">
                      <material:MaterialIcon Kind="LockOpen" Width="16" Height="16"
                                             Foreground="#8E9297"
                                             IsVisible="{Binding !Encrypt}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <material:MaterialIcon Kind="Lock" Width="16" Height="16"
                                             Foreground="#00E5FF"
                                             IsVisible="{Binding Encrypt}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Button>
                  <Button Grid.Column="2"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RenameDriveCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          Foreground="#8E9297"
                          Width="28" Height="38"
                          Padding="0"
                          CornerRadius="6"
                          ToolTip.Tip="Rename drive">
                    <material:MaterialIcon Kind="Pencil" Width="16" Height="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                  <Button Grid.Column="3"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveDriveCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          Foreground="#FF6B6B"
                          Width="28" Height="38"
                          Padding="0"
                          CornerRadius="6"
                          ToolTip.Tip="Remove drive">
                    <material:MaterialIcon Kind="Close" Width="16" Height="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="QUICK ACCESS" FontSize="11" FontWeight="Bold"
                     Foreground="#6A0DAD" Margin="12,16,0,10" LetterSpacing="2"
                     IsVisible="{Binding QuickAccessFolders.Count}"/>
          <ItemsControl ItemsSource="{Binding QuickAccessFolders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="sidebar-item" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenQuickAccessCommand}" CommandParameter="{Binding}">
                  <Button.ContextMenu>
                    <ContextMenu Background="#161B29" BorderBrush="#2A324A" Foreground="#E3E5E8">
                      <MenuItem Header="Remove" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveFromQuickAccessCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon><material:MaterialIcon Kind="Delete" Foreground="#ff6b6b"/></MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </Button.ContextMenu>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Panel Width="20" Height="20">
                      <material:MaterialIcon Kind="FolderStar" Width="20" Height="20" Foreground="#00E5FF"
                                             IsVisible="{Binding !IsFile}"/>
                      <material:MaterialIcon Kind="FileStarOutline" Width="20" Height="20" Foreground="#00E5FF"
                                             IsVisible="{Binding IsFile}"/>
                    </Panel>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main content -->
    <Grid Grid.Column="1" RowDefinitions="30,*">
      <!-- TitleBar background (custom) -->
      <Border Grid.Row="0" Background="#0B0F19" IsHitTestVisible="False">
        <TextBlock Text="{Binding DriveName, StringFormat='DiscBox - {0}'}" 
                   Foreground="#8E9297" FontSize="12" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <DockPanel Grid.Row="1" Background="#0B0F19">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#0B0F19" Height="70"
                BorderBrush="#2A324A" BorderThickness="0,0,0,1" Padding="20,0">
          <Grid ColumnDefinitions="Auto,*,280,Auto" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Command="{Binding GoUpCommand}"
                      Background="#161B29" Foreground="#00E5FF"
                      CornerRadius="8" Width="36" Height="36"
                      HorizontalContentAlignment="Center">
                <material:MaterialIcon Kind="ArrowLeft" Width="20" Height="20"/>
              </Button>
              <Button Command="{Binding RefreshCommand}"
                      Background="#161B29" Foreground="#E3E5E8"
                      CornerRadius="8" Width="36" Height="36"
                      HorizontalContentAlignment="Center">
                <material:MaterialIcon Kind="Refresh" Width="20" Height="20"/>
              </Button>
            </StackPanel>

            <!-- Breadcrumbs -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Breadcrumbs}"
                          Margin="12,0" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:BreadcrumbItem">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="{Binding Label}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateToCommand}"
                            CommandParameter="{Binding Path}"
                            Background="Transparent" Foreground="#8E9297"
                            Padding="8,4" CornerRadius="6" FontSize="14"/>
                    <material:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#6A0DAD"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
              <material:MaterialIcon Kind="Magnify" Width="18" Height="18"
                                     Foreground="#8E9297"
                                     Margin="11,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     IsHitTestVisible="False"/>
              <TextBox Classes="search-box"
                       Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="Search this drive"/>
            </Grid>

            <Button Grid.Column="3"
                    Command="{Binding NewFolderCommand}"
                    Background="#6A0DAD" Foreground="White"
                    CornerRadius="8" Padding="14,8" FontSize="13" FontWeight="SemiBold">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="FolderPlus" Width="18" Height="18"/>
                <TextBlock Text="New Folder" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#161B29"
                BorderBrush="#2A324A" BorderThickness="0,1,0,0" Padding="20,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                       Foreground="#8E9297" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentPath}"
                       Foreground="#00E5FF" FontSize="11" VerticalAlignment="Center"
                       FontFamily="Cascadia Code,Consolas,monospace"/>
          </Grid>
        </Border>

        <!-- File list -->
        <Grid x:Name="FileListHost"
              Margin="12"
              ClipToBounds="True">
        <ListBox x:Name="FileList"
                 ItemsSource="{Binding Entries}"
                 SelectionMode="Multiple"
                 SelectionChanged="OnFileSelectionChanged"
                 DoubleTapped="OnEntryDoubleTapped"
                 Background="Transparent">
          <ListBox.ContextMenu>
            <ContextMenu Background="#161B29" BorderBrush="#2A324A" Foreground="#E3E5E8">
              <MenuItem Header="Download" Command="{Binding DownloadEntryCommand}" CommandParameter="{Binding SelectedEntry}" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                <MenuItem.Icon><material:MaterialIcon Kind="Download"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Add to Quick Access" Command="{Binding AddToQuickAccessCommand}" CommandParameter="{Binding SelectedEntry}" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                <MenuItem.Icon><material:MaterialIcon Kind="FolderStar"/></MenuItem.Icon>
              </MenuItem>
              <Separator Background="#2A324A"/>
              <MenuItem Header="Cut" Command="{Binding CutEntryCommand}" CommandParameter="{Binding SelectedEntry}" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                <MenuItem.Icon><material:MaterialIcon Kind="ContentCut"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Copy" Command="{Binding CopyEntryCommand}" CommandParameter="{Binding SelectedEntry}" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                <MenuItem.Icon><material:MaterialIcon Kind="ContentCopy"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Paste" Command="{Binding PasteCommand}" IsVisible="{Binding HasClipboard}">
                <MenuItem.Icon><material:MaterialIcon Kind="ContentPaste"/></MenuItem.Icon>
              </MenuItem>
              <Separator Background="#2A324A"/>
              <MenuItem Header="Rename" Command="{Binding RenameEntryCommand}" CommandParameter="{Binding SelectedEntry}" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                <MenuItem.Icon><material:MaterialIcon Kind="Pencil"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Delete" Command="{Binding DeleteEntryCommand}" CommandParameter="{Binding SelectedEntry}" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="#ff6b6b">
                <MenuItem.Icon><material:MaterialIcon Kind="Delete" Foreground="#ff6b6b"/></MenuItem.Icon>
              </MenuItem>
              <Separator Background="#2A324A"/>
              <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedEntry}" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                <MenuItem.Icon><material:MaterialIcon Kind="Link"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}" CommandParameter="{Binding SelectedEntry}" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                <MenuItem.Icon><material:MaterialIcon Kind="Information"/></MenuItem.Icon>
              </MenuItem>
              <Separator Background="#2A324A"/>
              <MenuItem Header="New Folder" Command="{Binding NewFolderCommand}">
                <MenuItem.Icon><material:MaterialIcon Kind="FolderPlus"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Upload" Command="{Binding UploadFileCommand}">
                <MenuItem.Icon><material:MaterialIcon Kind="CloudUpload"/></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Upload folder" Command="{Binding UploadFolderCommand}">
                <MenuItem.Icon><material:MaterialIcon Kind="FolderUpload"/></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="m:FileEntry">
              <Border CornerRadius="8"
                      Padding="8"
                      Background="{Binding IsUiSelected, Converter={StaticResource SelectionBackgroundConverter}}">
                <Grid ColumnDefinitions="48,*,120,34,160" Height="48">
                  <Panel Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <material:MaterialIcon Kind="{Binding Converter={StaticResource FileEntryToIconConverter}}" 
                                           Foreground="{Binding Converter={StaticResource FileEntryToColorConverter}}" 
                                           Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding !HasThumbnail}"/>
                    <Border CornerRadius="6" ClipToBounds="True" IsVisible="{Binding HasThumbnail}">
                      <Image ctrl:AsyncImageLoader.SourceUrl="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                    </Border>
                  </Panel>

                  <TextBlock Grid.Column="1" Text="{Binding Name}"
                             Foreground="#E3E5E8" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                             Foreground="#8E9297" FontSize="13"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Margin="0,0,10,0"/>
                  <Button Grid.Column="3"
                          Classes="quick-access-toggle"
                          Click="OnQuickAccessStarClicked"
                          Width="32" Height="32"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Add to Quick Access">
                    <Panel Width="18" Height="18">
                      <material:MaterialIcon Kind="StarOutline" Width="18" Height="18"
                                             Foreground="#8E9297"
                                             IsVisible="{Binding !IsQuickAccess}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <material:MaterialIcon Kind="Star" Width="18" Height="18"
                                             Foreground="#FACC15"
                                             IsVisible="{Binding IsQuickAccess}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Button>
                  <TextBlock Grid.Column="4"
                             Text="{Binding ModifiedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                             Foreground="#6A0DAD" FontSize="12"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Margin="0,0,16,0"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
          <Canvas IsHitTestVisible="False" Panel.ZIndex="10">
            <Border x:Name="SelectionRectangle"
                    IsVisible="False"
                    Background="#663D1C8D"
                    BorderBrush="#FF00E5FF"
                    BorderThickness="2"
                    CornerRadius="3"/>
            <Border x:Name="MiddleScrollIndicator"
                    IsVisible="False"
                    Width="34"
                    Height="34"
                    Background="#E61A2033"
                    BorderBrush="#00E5FF"
                    BorderThickness="1"
                    CornerRadius="17">
              <material:MaterialIcon Kind="SwapVertical"
                                     Foreground="#00E5FF"
                                     Width="20" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
            </Border>
          </Canvas>
          <Border x:Name="DropUploadOverlay"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  Background="#D90B0F19"
                  BorderBrush="#00E5FF"
                  BorderThickness="1"
                  CornerRadius="12">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
              <Border Width="72" Height="72"
                      CornerRadius="20"
                      Background="#1A2033"
                      BorderBrush="#6A0DAD"
                      BorderThickness="1">
                <material:MaterialIcon Kind="CloudUpload"
                                       Width="38" Height="38"
                                       Foreground="#00E5FF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Drop to upload"
                         Foreground="#E3E5E8"
                         FontSize="20"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="Files and folders will be uploaded to the current drive"
                         Foreground="#8E9297"
                         FontSize="13"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>

      </DockPanel>
    </Grid>

  </Grid>
</Window>
