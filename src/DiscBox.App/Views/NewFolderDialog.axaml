<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="DiscBox.Views.NewFolderDialog"
        Title="Nova Pasta"
        Width="400" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F19"
        ExtendClientAreaToDecorationsHint="True">

  <Grid RowDefinitions="30,*">
    <!-- TitleBar background -->
    <Border Grid.Row="0" Background="#0B0F19" IsHitTestVisible="False">
      <TextBlock Text="Nova Pasta" 
                 Foreground="#8E9297" FontSize="12" 
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    <Border Grid.Row="1" Background="#161B29" CornerRadius="0" Padding="28">
      <StackPanel Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <material:MaterialIcon Kind="FolderPlus" Foreground="#00E5FF" Width="24" Height="24"/>
          <TextBlock Text="Nome da pasta:"
                     Foreground="#E3E5E8" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBox x:Name="FolderNameBox"
                 Watermark="ex: Fotos, Videos, Documentos..."
                 Background="#0B0F19" Foreground="#E3E5E8"
                 BorderBrush="#2A324A" CornerRadius="8"
                 Padding="16,12" FontSize="14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
          <Button Content="Cancelar" Click="OnCancel"
                  Background="#2A324A" Foreground="#E3E5E8"
                  CornerRadius="8" Padding="20,10" FontWeight="SemiBold"/>
          <Button Content="Criar" Click="OnCreate"
                  Background="#6A0DAD" Foreground="White"
                  CornerRadius="8" Padding="20,10" FontWeight="Bold"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>