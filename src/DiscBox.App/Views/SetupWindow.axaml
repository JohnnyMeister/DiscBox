<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiscBox.ViewModels"
        xmlns:converters="using:DiscBox.Converters"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="DiscBox.Views.SetupWindow"
        x:DataType="vm:SetupViewModel"
        Title="DiscBox — Setup"
        Width="540" Height="600"
        MinWidth="540" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#0B0F19"
        ExtendClientAreaToDecorationsHint="True">

  <!-- Content with TitleBar spacing since ExtendClientArea is True -->
  <Grid RowDefinitions="30,*">
    
    <!-- TitleBar background (custom) -->
    <Border Grid.Row="0" Background="#0B0F19" IsHitTestVisible="False">
      <TextBlock Text="DiscBox — Setup" 
                 Foreground="#8E9297" FontSize="12" 
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">

      <!-- Header -->
      <Border Grid.Row="0" Background="#0B0F19" Padding="0,32,0,24">
        <StackPanel HorizontalAlignment="Center" Spacing="16">
          <Image Source="avares://DiscBox/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center"/>
          <TextBlock Text="DiscBox" FontSize="32" FontWeight="Bold"
                     Foreground="#00E5FF" HorizontalAlignment="Center"/>
          <TextBlock Text="Your Discord as personal cloud storage"
                     Foreground="#8E9297" FontSize="14"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Form -->
      <ScrollViewer Grid.Row="1" Padding="40,16">
        <StackPanel Spacing="24">

          <!-- Step 1: Webhook -->
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <material:MaterialIcon Kind="Webhook" Foreground="#6A0DAD" Width="20" Height="20"/>
              <TextBlock Text="1. Discord Webhook URL" FontWeight="Bold"
                         Foreground="#E3E5E8" FontSize="14"/>
            </StackPanel>
            <TextBlock FontSize="12" Foreground="#8E9297" TextWrapping="Wrap" Margin="28,0,0,8">
              In your Discord server, go to a channel → Edit → Integrations → Webhooks → New Webhook → Copy URL.
            </TextBlock>
            <TextBox Watermark="https://discord.com/api/webhooks/..."
                     Text="{Binding WebhookUrl}"
                     FontFamily="Cascadia Code,Consolas,monospace"
                     FontSize="13"
                     Background="#161B29"
                     Foreground="#00E5FF"
                     BorderBrush="#2A324A"
                     BorderThickness="1"
                     CornerRadius="8"
                     Padding="16,12"/>
          </StackPanel>

          <!-- Step 2: Drive name -->
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <material:MaterialIcon Kind="Harddisk" Foreground="#6A0DAD" Width="20" Height="20"/>
              <TextBlock Text="2. Drive Name" FontWeight="Bold"
                         Foreground="#E3E5E8" FontSize="14"/>
            </StackPanel>
            <TextBox Watermark="My DiscBox"
                     Text="{Binding DriveName}"
                     Background="#161B29"
                     Foreground="#E3E5E8"
                     BorderBrush="#2A324A"
                     BorderThickness="1"
                     CornerRadius="8"
                     Padding="16,12"
                     FontSize="14"/>
          </StackPanel>

          <!-- Step 3: Encryption -->
          <Border Background="#161B29" BorderBrush="#2A324A" BorderThickness="1"
                  CornerRadius="8" Padding="20">
            <StackPanel Spacing="8">
              <CheckBox IsChecked="{Binding Encrypt}" Foreground="#E3E5E8" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <material:MaterialIcon Kind="ShieldLock" Foreground="#00E5FF" Width="18" Height="18"/>
                  <TextBlock Text="Encrypt files (AES-256-GCM)" VerticalAlignment="Center"/>
                </StackPanel>
              </CheckBox>
              <TextBlock FontSize="12" Foreground="#8E9297" TextWrapping="Wrap"
                         Margin="28,0,0,0">
                Encrypts each chunk before uploading. Files are unreadable without
                your webhook URL. Cannot be changed after upload.
              </TextBlock>
            </StackPanel>
          </Border>

          <!-- Status message -->
          <Border IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                  Background="#331A1A" BorderBrush="#FF4B4B" BorderThickness="1"
                  CornerRadius="8" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <material:MaterialIcon Kind="AlertCircleOutline" Foreground="#FF4B4B" Width="20" Height="20"/>
              <TextBlock Text="{Binding StatusMessage}"
                         Foreground="#FF4B4B"
                         FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- Footer buttons -->
      <Border Grid.Row="2" Background="#161B29" Padding="40,24" BorderBrush="#2A324A" BorderThickness="0,1,0,0">
        <Button Command="{Binding SaveCommand}"
                IsEnabled="{Binding !IsValidating}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Height="48"
                FontSize="15"
                FontWeight="Bold"
                Background="#6A0DAD"
                Foreground="White"
                CornerRadius="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <material:MaterialIcon Kind="CheckCircleOutline" Width="22" Height="22"/>
            <TextBlock Text="Connect to Discord" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Border>

    </Grid>
  </Grid>
</Window>
