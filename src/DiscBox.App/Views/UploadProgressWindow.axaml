<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiscBox.ViewModels"
        x:Class="DiscBox.Views.UploadProgressWindow"
        x:DataType="vm:UploadProgressViewModel"
        Title="DiscBox — Upload"
        Width="420" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0f1117">

  <StackPanel Margin="32" Spacing="16">

    <TextBlock Text="{Binding FileName}"
               Foreground="#e3e5e8" FontSize="14" FontWeight="SemiBold"
               TextTrimming="CharacterEllipsis"/>

    <ProgressBar Value="{Binding Percent}"
                 Minimum="0" Maximum="100"
                 Height="8" CornerRadius="4"
                 Foreground="#5865f2" Background="#2e3148"/>

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0"
                 Text="{Binding StatusText}"
                 Foreground="#8e9297" FontSize="12"/>
      <TextBlock Grid.Column="1"
                 Text="{Binding Percent, StringFormat='{}{0}%'}"
                 Foreground="#5865f2" FontSize="12" FontWeight="SemiBold"/>
    </Grid>

    <Button Content="Cancelar"
            Command="{Binding CancelCommand}"
            IsEnabled="{Binding !IsDone}"
            HorizontalAlignment="Right"
            Background="#2e3148" Foreground="#e3e5e8"
            CornerRadius="6" Padding="16,6"/>

  </StackPanel>
</Window>